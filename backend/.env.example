# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wallet_dashboard

# App
NODE_ENV=development
PORT=3001

# Auth
JWT_SECRET=<min 64 chars random>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Encryption (pour les tokens OAuth Revolut)
ENCRYPTION_KEY=<32 bytes hex>

# Revolut — optionnel : laisser vide désactive le sync (POST /accounts/:id/sync/revolut renvoie 501)
REVOLUT_CLIENT_ID=
REVOLUT_CLIENT_SECRET=
REVOLUT_ENVIRONMENT=sandbox

# Crypto — Solana RPC public fonctionne sans clé ; Etherscan/Crypto.com optionnels
# (laisser vide désactive leur sync, POST /crypto/wallets/:id/sync renvoie 501)
ETHERSCAN_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
CRYPTO_COM_API_KEY=
CRYPTO_COM_API_SECRET=

# La variable Pokemon TCG sera ajoutée ici à l'étape du module collectibles.
