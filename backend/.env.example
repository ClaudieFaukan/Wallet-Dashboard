# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wallet_dashboard

# App
NODE_ENV=development
PORT=3001

# Auth
JWT_SECRET=<min 64 chars random>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Encryption (pour les tokens OAuth Revolut)
ENCRYPTION_KEY=<32 bytes hex>

REVOLUT_ENVIRONMENT=sandbox

# Crypto — Solana RPC public fonctionne sans clé
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Toutes les clés API (Revolut, Etherscan, Crypto.com, PokemonPriceTracker, Poketrace) se
# configurent depuis Settings dans l'app une fois connecté (chiffrées en base, table app_settings) —
# aucune variable d'environnement à renseigner ici pour ces intégrations.
